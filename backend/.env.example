# ─── App ──────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── MongoDB ───────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/momentgrid

# ─── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Nodemailer / Ethereal auto-created in dev) ─
# Leave blank in dev — Ethereal test account is created automatically.
# Set these in production (SMTP or SendGrid relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@momentgrid.io
EMAIL_FROM_NAME=MomentGrid
